import { useState } from 'react';
import './App.css';
import Header from './components/Header';
import Hero from './components/Hero';
import Menu from './components/Menu';
import Contact from './components/Contact';
import Footer from './components/Footer';
import Cart from './components/Cart'; // New Cart component

function App() {
	const [theme, setTheme] = useState('dark');
	const [cart, setCart] = useState([]); // Cart state
	const [isCartOpen, setIsCartOpen] = useState(false);

	const toggleTheme = () => {
		const newTheme = theme === 'dark' ? 'light' : 'dark';
		setTheme(newTheme);
		document.body.className = newTheme;
	};

	// Cart functions with immutability
	const addToCart = (item) => {
		const existingItem = cart.find((cartItem) => cartItem.id === item.id);
		if (existingItem) {
			// Increase quantity if exists
			setCart(
				cart.map((cartItem) =>
					cartItem.id === item.id
						? { ...cartItem, quantity: cartItem.quantity + 1 }
						: cartItem
				)
			);
		} else {
			// Add new item with quantity 1
			setCart([...cart, { ...item, quantity: 1 }]);
		}
	};

	const removeFromCart = (itemId) => {
		setCart(cart.filter((item) => item.id !== itemId));
	};

	const updateQuantity = (itemId, quantity) => {
		if (quantity <= 0) {
			removeFromCart(itemId);
		} else {
			setCart(
				cart.map((item) =>
					item.id === itemId ? { ...item, quantity } : item
				)
			);
		}
	};

	const clearCart = () => {
		setCart([]);
	};

		const toggleCart = () => setIsCartOpen((s) => !s);

	return (
		<div className="App">
					<Header toggleTheme={toggleTheme} theme={theme} cartCount={cart.reduce((s, i) => s + (i.quantity || 0), 0)} onCartClick={toggleCart} />
			<Hero />
			<Menu addToCart={addToCart} /> {/* Pass addToCart to Menu */}
					<Cart
						isOpen={isCartOpen}
						onClose={toggleCart}
						cart={cart}
						removeFromCart={removeFromCart}
						updateQuantity={updateQuantity}
						clearCart={clearCart}
					/>
			<Contact />
			<Footer />
		</div>
	);
}

export default App;